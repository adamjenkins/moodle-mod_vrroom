{{!
    @template mod_mavr/view_page

    The activity page: the learner's attempts, the final grade, a message and the root element
    the run mode's client renders into.

    Classes required for JS:
    * mavr-root

    Data attributes required for JS:
    * data-region="mavr-root"
    * data-cmid

    Context variables required for this template:
    * rootid - id of the root element
    * cmid - course module id
    * hasroot - whether the run mode can launch (root is rendered)
    * hasattempts - whether there are attempts to list
    * attempts - list of attempts: attempt, state, score, grade, timefinish
    * finalgrade - formatted final grade line, or empty
    * message - information message, or empty
    * reporturl - URL of the reports page, or empty
    * editurl - URL of the room editor, or empty

    Example context (json):
    {
        "rootid": "mavr-root-12",
        "cmid": 12,
        "hasroot": true,
        "hasattempts": true,
        "attempts": [
            {"attempt": 1, "state": "Finished", "score": "75.00%", "grade": "75.00",
             "timefinish": "Thursday, 8 October 2026, 10:00 AM"}
        ],
        "finalgrade": "Your final grade: 75.00 / 100.00",
        "message": "No more attempts are allowed.",
        "reporturl": "https://example.com/mod/mavr/report.php?id=12",
        "editurl": "https://example.com/mod/mavr/edit.php?id=12"
    }
}}
<div class="mod-mavr-view">
    {{#hasattempts}}
    <h3 class="h5">{{#str}}yourattempts, mod_mavr{{/str}}</h3>
    <div class="table-responsive">
        <table class="table table-sm mavr-attempts">
            <thead>
                <tr>
                    <th scope="col">{{#str}}attemptnumber, mod_mavr{{/str}}</th>
                    <th scope="col">{{#str}}attemptstate, mod_mavr{{/str}}</th>
                    <th scope="col">{{#str}}attemptscore, mod_mavr{{/str}}</th>
                    <th scope="col">{{#str}}attemptgrade, mod_mavr{{/str}}</th>
                    <th scope="col">{{#str}}attemptfinished, mod_mavr{{/str}}</th>
                </tr>
            </thead>
            <tbody>
                {{#attempts}}
                <tr>
                    <td>{{attempt}}</td>
                    <td>{{state}}</td>
                    <td>{{score}}</td>
                    <td>{{grade}}</td>
                    <td>{{timefinish}}</td>
                </tr>
                {{/attempts}}
            </tbody>
        </table>
    </div>
    {{/hasattempts}}
    {{#finalgrade}}
    <p class="fw-bold mavr-finalgrade">{{finalgrade}}</p>
    {{/finalgrade}}
    {{#message}}
    <div class="alert alert-info" role="status">{{message}}</div>
    {{/message}}
    {{#editurl}}
    <p><a class="btn btn-secondary" href="{{editurl}}" data-action="mavr-edit-room">{{#str}}editroom, mod_mavr{{/str}}</a></p>
    {{/editurl}}
    {{#reporturl}}
    <p><a href="{{reporturl}}">{{#str}}reportlink, mod_mavr{{/str}}</a></p>
    {{/reporturl}}
    {{#hasroot}}
    <div id="{{rootid}}" class="mavr-root" data-region="mavr-root" data-cmid="{{cmid}}"></div>
    {{/hasroot}}
</div>
