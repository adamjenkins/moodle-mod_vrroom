{{!
    @template mod_vrroom/editor_outline

    The room editor's outline: the rooms, then the objects of the chosen room grouped by kind.
    Every entry is a button, so the whole room can be edited with the keyboard.

    Data attributes required for JS:
    * data-action="vrroom-editor-scene" with data-scene
    * data-action="vrroom-editor-addscene", "vrroom-editor-addphotoscene", "vrroom-editor-scene-up", "vrroom-editor-scene-down", "vrroom-editor-scene-delete"
    * data-action="vrroom-editor-select" with data-kind and data-id
    * data-group on each section

    Context variables required for this template:
    * scenes - list of rooms: id, name, active, start
    * canaddscene - whether another room may be added
    * haspresets - whether built-in surroundings exist (the "Add room" button; photo rooms are always offered)
    * canmoveup, canmovedown, candelete - what the chosen room allows
    * groups - list of groups: group, heading, items (kind, id, name, selected)

    Example context (json):
    {
        "scenes": [
            {"id": "5d1c2c6e-6c2f-4d0e-9a51-7b1d0e9c2a11", "name": "Gallery", "active": true, "start": true}
        ],
        "canaddscene": true,
        "haspresets": true,
        "canmoveup": false,
        "canmovedown": false,
        "candelete": false,
        "groups": [
            {"group": "environment", "heading": "Surroundings", "items": [
                {"kind": "environment", "id": "5d1c2c6e-6c2f-4d0e-9a51-7b1d0e9c2a11", "name": "Surroundings", "selected": false}
            ]},
            {"group": "zone", "heading": "Zone", "items": [
                {"kind": "zone", "id": "z-1", "name": "Vase", "selected": true}
            ]}
        ]
    }
}}
<section class="vrroom-editor-scenes mb-3" data-group="scenes">
    <h3 class="h6">{{#str}}editorscenes, mod_vrroom{{/str}}</h3>
    <ul class="list-unstyled mb-2">
        {{#scenes}}
        <li>
            <button type="button" class="btn btn-link btn-sm text-start{{#active}} fw-bold{{/active}}" data-action="vrroom-editor-scene"
                    data-scene="{{id}}" aria-pressed="{{#active}}true{{/active}}{{^active}}false{{/active}}">{{name}}</button>
            {{#start}}<span class="badge border border-secondary text-body">{{#str}}editorstartscene, mod_vrroom{{/str}}</span>{{/start}}
        </li>
        {{/scenes}}
    </ul>
    <div class="d-flex flex-wrap gap-1">
        {{#haspresets}}
        <button type="button" class="btn btn-outline-secondary btn-sm" data-action="vrroom-editor-addscene"{{^canaddscene}} disabled{{/canaddscene}}>{{#str}}editoraddscene, mod_vrroom{{/str}}</button>
        {{/haspresets}}
        <button type="button" class="btn btn-outline-secondary btn-sm" data-action="vrroom-editor-addphotoscene"{{^canaddscene}} disabled{{/canaddscene}}>{{#str}}editoraddphotoscene, mod_vrroom{{/str}}</button>
        <button type="button" class="btn btn-outline-secondary btn-sm" data-action="vrroom-editor-scene-up"{{^canmoveup}} disabled{{/canmoveup}}>{{#str}}editormovesceneup, mod_vrroom{{/str}}</button>
        <button type="button" class="btn btn-outline-secondary btn-sm" data-action="vrroom-editor-scene-down"{{^canmovedown}} disabled{{/canmovedown}}>{{#str}}editormovescenedown, mod_vrroom{{/str}}</button>
        <button type="button" class="btn btn-outline-danger btn-sm" data-action="vrroom-editor-scene-delete"{{^candelete}} disabled{{/candelete}}>{{#str}}editordeletescene, mod_vrroom{{/str}}</button>
    </div>
</section>
{{#groups}}
<section class="vrroom-editor-group mb-2" data-group="{{group}}">
    <h3 class="h6">{{heading}}</h3>
    <ul class="list-unstyled mb-0">
        {{#items}}
        <li>
            <button type="button" class="btn btn-link btn-sm text-start{{#selected}} fw-bold{{/selected}}" data-action="vrroom-editor-select"
                    data-kind="{{kind}}" data-id="{{id}}" aria-pressed="{{#selected}}true{{/selected}}{{^selected}}false{{/selected}}">{{name}}</button>
        </li>
        {{/items}}
    </ul>
</section>
{{/groups}}
