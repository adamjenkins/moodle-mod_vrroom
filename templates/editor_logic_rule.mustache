{{!
    @template mod_mavr/editor_logic_rule

    One rule card of the logic editor: when something happens, then run some actions.
    All labels are plain text.

    Context variables required for this template:
    * uid, index, heading, isfirst, islast, once
    * triggeroptions; isevent + verboptions, kindoptions, idgroups, hasid;
      isobjectivetrigger + objectiveoptions
    * actions - list of {index, ruleindex, number, dooptions, hastarget, targetgroups}
    Option lists are {value, label, selected}; groups are {label, options}.

    Example context (json):
    {
        "uid": "12", "index": 0, "heading": "Rule 1", "isfirst": true, "islast": true, "once": true,
        "triggeroptions": [{"value": "objective_completed", "label": "an objective is completed", "selected": true}],
        "isevent": false, "isobjectivetrigger": true,
        "objectiveoptions": [{"value": "v-desk", "label": "Search Desk", "selected": true}],
        "actions": [
            {"index": 0, "ruleindex": 0, "number": 1, "hastarget": true,
             "dooptions": [{"value": "show", "label": "Show", "selected": true}],
             "targetgroups": [{"label": "", "options": [{"value": "g-key", "label": "Brass key", "selected": true}]}]}
        ]
    }
}}
<li class="card mb-3" data-region="mavr-logic-rule" data-rule-index="{{index}}">
    <fieldset class="card-body">
        <legend class="h6">{{heading}}</legend>
        <div class="row g-3">
            <div class="col-12 col-md-6">
                <label class="form-label" for="mavr-logic-{{uid}}-r{{index}}-trigger">{{#str}}logicwhen, mod_mavr{{/str}}</label>
                <select class="form-select" id="mavr-logic-{{uid}}-r{{index}}-trigger" data-field="trigger">
                    {{#triggeroptions}}<option value="{{value}}"{{#selected}} selected{{/selected}}>{{label}}</option>{{/triggeroptions}}
                </select>
            </div>
            {{#isobjectivetrigger}}
            <div class="col-12 col-md-6">
                <label class="form-label" for="mavr-logic-{{uid}}-r{{index}}-objective">{{#str}}logictriggerobjective, mod_mavr{{/str}}</label>
                <select class="form-select" id="mavr-logic-{{uid}}-r{{index}}-objective" data-field="triggerobjective">
                    {{#objectiveoptions}}<option value="{{value}}"{{#selected}} selected{{/selected}}>{{label}}</option>{{/objectiveoptions}}
                </select>
            </div>
            {{/isobjectivetrigger}}
            {{#isevent}}
            <div class="col-12 col-md-4">
                <label class="form-label" for="mavr-logic-{{uid}}-r{{index}}-verb">{{#str}}logicverb, mod_mavr{{/str}}</label>
                <select class="form-select" id="mavr-logic-{{uid}}-r{{index}}-verb" data-field="verb">
                    {{#verboptions}}<option value="{{value}}"{{#selected}} selected{{/selected}}>{{label}}</option>{{/verboptions}}
                </select>
            </div>
            <div class="col-12 col-md-4">
                <label class="form-label" for="mavr-logic-{{uid}}-r{{index}}-kind">{{#str}}logicobjecttype, mod_mavr{{/str}}</label>
                <select class="form-select" id="mavr-logic-{{uid}}-r{{index}}-kind" data-field="kind">
                    {{#kindoptions}}<option value="{{value}}"{{#selected}} selected{{/selected}}>{{label}}</option>{{/kindoptions}}
                </select>
            </div>
            {{#hasid}}
            <div class="col-12 col-md-4">
                <label class="form-label" for="mavr-logic-{{uid}}-r{{index}}-id">{{#str}}logicwhich, mod_mavr{{/str}}</label>
                <select class="form-select" id="mavr-logic-{{uid}}-r{{index}}-id" data-field="eventid">
                    {{#idgroups}}
                    {{#label}}<optgroup label="{{label}}">{{/label}}
                    {{#options}}<option value="{{value}}"{{#selected}} selected{{/selected}}>{{label}}</option>{{/options}}
                    {{#label}}</optgroup>{{/label}}
                    {{/idgroups}}
                </select>
            </div>
            {{/hasid}}
            {{/isevent}}
            <div class="col-12">
                <div class="form-check">
                    <input type="checkbox" class="form-check-input" id="mavr-logic-{{uid}}-r{{index}}-once"
                           data-field="once"{{#once}} checked{{/once}}>
                    <label class="form-check-label" for="mavr-logic-{{uid}}-r{{index}}-once">{{#str}}logiconce, mod_mavr{{/str}}</label>
                </div>
            </div>
            <div class="col-12">
                <fieldset>
                    <legend class="form-label fs-6">{{#str}}logicthen, mod_mavr{{/str}}</legend>
                    <ol class="ps-3">
                        {{#actions}}
                        <li class="mb-2" data-action-index="{{index}}">
                            <div class="d-flex flex-wrap align-items-end gap-2">
                                <div>
                                    <label class="visually-hidden" for="mavr-logic-{{uid}}-r{{ruleindex}}-a{{index}}-do">{{#str}}logicactionno, mod_mavr, {{number}}{{/str}}</label>
                                    <select class="form-select w-auto" id="mavr-logic-{{uid}}-r{{ruleindex}}-a{{index}}-do" data-field="do">
                                        {{#dooptions}}<option value="{{value}}"{{#selected}} selected{{/selected}}>{{label}}</option>{{/dooptions}}
                                    </select>
                                </div>
                                {{#hastarget}}
                                <div>
                                    <label class="visually-hidden" for="mavr-logic-{{uid}}-r{{ruleindex}}-a{{index}}-target">{{#str}}logicactiontarget, mod_mavr, {{number}}{{/str}}</label>
                                    <select class="form-select w-auto" id="mavr-logic-{{uid}}-r{{ruleindex}}-a{{index}}-target" data-field="actiontarget">
                                        {{#targetgroups}}
                                        {{#label}}<optgroup label="{{label}}">{{/label}}
                                        {{#options}}<option value="{{value}}"{{#selected}} selected{{/selected}}>{{label}}</option>{{/options}}
                                        {{#label}}</optgroup>{{/label}}
                                        {{/targetgroups}}
                                    </select>
                                </div>
                                {{/hastarget}}
                                <button type="button" class="btn btn-outline-secondary btn-sm" data-action="mavr-logic-remove-action">{{#str}}logicremove, mod_mavr{{/str}}</button>
                            </div>
                        </li>
                        {{/actions}}
                    </ol>
                    <button type="button" class="btn btn-outline-secondary btn-sm" data-action="mavr-logic-add-action">{{#str}}logicaddaction, mod_mavr{{/str}}</button>
                </fieldset>
            </div>
        </div>
        <div class="d-flex flex-wrap gap-2 mt-3">
            {{^isfirst}}<button type="button" class="btn btn-outline-secondary btn-sm" data-action="mavr-logic-rule-up">{{#str}}logicmoveup, mod_mavr{{/str}}</button>{{/isfirst}}
            {{^islast}}<button type="button" class="btn btn-outline-secondary btn-sm" data-action="mavr-logic-rule-down">{{#str}}logicmovedown, mod_mavr{{/str}}</button>{{/islast}}
            <button type="button" class="btn btn-outline-danger btn-sm" data-action="mavr-logic-remove-rule">{{#str}}logicremove, mod_mavr{{/str}}</button>
        </div>
    </fieldset>
</li>
