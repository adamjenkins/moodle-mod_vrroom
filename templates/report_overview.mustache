{{!
    @template mod_mavr/report_overview

    The attempts overview of the MAVR report.

    Classes required for JS:
    * none

    Data attributes required for JS:
    * none

    Context variables required for this template:
    * cmid - course module id
    * hasattempts - whether there are attempts
    * attempts - rows: attemptid, user, userurl, attempt, state, score, grade, timestart, timefinish,
      viewurl, candelete, deleteurl

    Example context (json):
    {
        "cmid": 12,
        "hasattempts": true,
        "attempts": [
            {
                "attemptid": 7,
                "user": "Student One",
                "userurl": "https://example.com/user/view.php?id=5&course=2",
                "attempt": 1,
                "state": "Finished",
                "score": "75.00 %",
                "grade": "75.00",
                "timestart": "Thursday, 8 October 2026, 10:00 AM",
                "timefinish": "Thursday, 8 October 2026, 10:20 AM",
                "viewurl": "https://example.com/mod/mavr/report.php?id=12&attemptid=7",
                "candelete": true,
                "deleteurl": "https://example.com/mod/mavr/report.php?id=12&delete=7"
            }
        ]
    }
}}
<div class="mod-mavr-report" data-region="mavr-report-overview">
    <h3>{{#str}}reportoverview, mod_mavr{{/str}}</h3>
    {{#hasattempts}}
    <div class="table-responsive">
        <table class="table table-striped table-sm generaltable" data-region="mavr-report-attempts">
            <thead>
                <tr>
                    <th scope="col">{{#str}}reportuser, mod_mavr{{/str}}</th>
                    <th scope="col">{{#str}}reportattempt, mod_mavr{{/str}}</th>
                    <th scope="col">{{#str}}reportstate, mod_mavr{{/str}}</th>
                    <th scope="col">{{#str}}reportscore, mod_mavr{{/str}}</th>
                    <th scope="col">{{#str}}reportgrade, mod_mavr{{/str}}</th>
                    <th scope="col">{{#str}}reporttimestart, mod_mavr{{/str}}</th>
                    <th scope="col">{{#str}}reporttimefinish, mod_mavr{{/str}}</th>
                    <th scope="col">{{#str}}reportactions, mod_mavr{{/str}}</th>
                </tr>
            </thead>
            <tbody>
                {{#attempts}}
                <tr data-attemptid="{{attemptid}}">
                    <td><a href="{{userurl}}">{{user}}</a></td>
                    <td>{{attempt}}</td>
                    <td>{{state}}</td>
                    <td>{{score}}</td>
                    <td>{{grade}}</td>
                    <td>{{timestart}}</td>
                    <td>{{timefinish}}</td>
                    <td>
                        <a href="{{viewurl}}" class="me-2">{{#str}}reportviewattempt, mod_mavr{{/str}}</a>
                        {{#candelete}}
                        <a href="{{deleteurl}}" class="text-danger">{{#str}}reportdeleteattempt, mod_mavr{{/str}}</a>
                        {{/candelete}}
                    </td>
                </tr>
                {{/attempts}}
            </tbody>
        </table>
    </div>
    {{/hasattempts}}
    {{^hasattempts}}
    <div class="alert alert-info">{{#str}}noattempts, mod_mavr{{/str}}</div>
    {{/hasattempts}}
</div>
