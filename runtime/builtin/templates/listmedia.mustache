{{!
    @template vrroomruntime_builtin/listmedia

    One picture, audio or video of a hotspot in the list view (a partial of
    vrroomruntime_builtin/listview).

    Context variables required for this template:
    * url - file URL
    * alt - plain-text label
    * isimage, isaudio, isvideo - which element to show

    Example context (json):
    {
        "url": "https://example.com/pluginfile.php/1/mod_vrroom/media/2/guide.mp3",
        "alt": "The Vase",
        "isimage": false,
        "isaudio": true,
        "isvideo": false
    }
}}
{{#isimage}}<img class="img-fluid d-block mb-2" src="{{url}}" alt="{{alt}}">{{/isimage}}
{{#isaudio}}<audio class="d-block mb-2" controls preload="none" src="{{url}}" aria-label="{{alt}}"></audio>{{/isaudio}}
{{#isvideo}}<video class="d-block w-100 mb-2" controls playsinline preload="none" src="{{url}}" aria-label="{{alt}}"></video>{{/isvideo}}
