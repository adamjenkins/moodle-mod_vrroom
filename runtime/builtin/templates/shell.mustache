{{!
    @template mavrruntime_builtin/shell

    The frame of the built-in viewer: launch buttons, message region, 3D stage, list view,
    progress panel and the live region for screen readers.

    Classes required for JS:
    * none

    Data attributes required for JS:
    * data-region and data-action values below

    Context variables required for this template:
    * cmid - course module id
    * canstart - show the buttons that start or resume an attempt
    * canpreview - show the preview buttons
    * nolaunch - neither applies; the message region shows a notice

    Example context (json):
    {
        "cmid": 12,
        "canstart": true,
        "canpreview": true,
        "nolaunch": false
    }
}}
<div class="mavr-shell" data-region="mavr-shell">
    <div class="mavr-launchbar d-flex flex-wrap gap-2 mb-3" data-region="mavr-launchbar">
        {{#canstart}}
        <button type="button" class="btn btn-primary" data-action="mavr-enter-3d">{{#str}}enter3d, mavrruntime_builtin{{/str}}</button>
        <button type="button" class="btn btn-secondary" data-action="mavr-enter-list">{{#str}}enterlist, mavrruntime_builtin{{/str}}</button>
        {{/canstart}}
        {{#canpreview}}
        <button type="button" class="btn btn-outline-secondary" data-action="mavr-preview-3d">{{#str}}preview3d, mavrruntime_builtin{{/str}}</button>
        <button type="button" class="btn btn-outline-secondary" data-action="mavr-preview-list">{{#str}}previewlist, mavrruntime_builtin{{/str}}</button>
        {{/canpreview}}
    </div>
    <div class="alert alert-warning{{^nolaunch}} d-none{{/nolaunch}}" data-region="mavr-message" role="status">{{#nolaunch}}{{#str}}nolaunch, mavrruntime_builtin{{/str}}{{/nolaunch}}</div>
    <div class="mavr-stage d-none" data-region="mavr-stage">
        <canvas class="mavr-canvas" data-region="mavr-canvas" tabindex="0" role="application" aria-label="{{#str}}viewerlabel, mavrruntime_builtin{{/str}}" aria-describedby="mavr-controlshelp-{{cmid}}"></canvas>
        <p class="visually-hidden" id="mavr-controlshelp-{{cmid}}">{{#str}}controlshelp, mavrruntime_builtin{{/str}}</p>
        <div class="mavr-hud" data-region="mavr-hud">
            <span class="mavr-crosshair" aria-hidden="true"></span>
            <div class="mavr-stick" data-region="mavr-stick" aria-hidden="true"><span class="mavr-stick-knob" data-region="mavr-stick-knob"></span></div>
            <div class="mavr-hud-buttons d-flex flex-wrap gap-2">
                <button type="button" class="btn btn-light btn-sm" data-action="mavr-toggle-progress" aria-expanded="false" aria-controls="mavr-progress-{{cmid}}">{{#str}}progress, mavrruntime_builtin{{/str}}</button>
                <button type="button" class="btn btn-light btn-sm" data-action="mavr-switch-list">{{#str}}switchtolist, mavrruntime_builtin{{/str}}</button>
            </div>
        </div>
        <div class="mavr-overlay" data-region="mavr-overlay"></div>
    </div>
    <div class="mavr-list d-none" data-region="mavr-list"></div>
    <aside class="mavr-progress d-none" id="mavr-progress-{{cmid}}" data-region="mavr-progress"></aside>
    <div class="visually-hidden" aria-live="polite" aria-atomic="true" data-region="mavr-live"></div>
</div>
