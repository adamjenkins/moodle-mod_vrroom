{{!
    @template mavrruntime_builtin/question

    A question-bank question rendered by the question engine, with a submit button until it has
    been answered. The html is rendered by the server's question renderer.

    Context variables required for this template:
    * slot - question slot
    * html - question HTML from the server
    * answered - true once the question engine has graded it
    * locked - show the locked notice instead of the question
    * lockedmessage - plain-text notice for locked or preview questions
    * retry - the answer fell short of what the objective needs; the question has been restarted
      and Try again loads the fresh question

    Example context (json):
    {
        "slot": 1,
        "html": "<div class=\"que multichoice\"><div class=\"qtext\">Which century?</div></div>",
        "answered": false,
        "locked": false,
        "lockedmessage": "",
        "retry": false
    }
}}
{{#locked}}
<p class="text-muted" data-region="mavr-question-locked">{{lockedmessage}}</p>
{{/locked}}
{{^locked}}
<form class="mavr-question-form" data-region="mavr-question-form" data-slot="{{slot}}" data-double-submit-protection="off" novalidate>
    <div data-region="mavr-question-html">{{{html}}}</div>
    {{^answered}}<button type="submit" class="btn btn-primary mt-2" data-action="mavr-submit-question">{{#str}}submitanswer, mavrruntime_builtin{{/str}}</button>{{/answered}}
</form>
{{#retry}}
<p class="alert alert-warning mt-2" data-region="mavr-retry-notice">{{#str}}retrynotice, mavrruntime_builtin{{/str}}</p>
<button type="button" class="btn btn-secondary mt-2" data-action="mavr-retry-question">{{#str}}tryagain, mavrruntime_builtin{{/str}}</button>
{{/retry}}
{{/locked}}
