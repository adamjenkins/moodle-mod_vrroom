{{!
    @template vrroomruntime_builtin/listview

    The accessible list view: every station of every room as a section that can be opened with
    the keyboard, with its texts, images, audio, video, questions and the objects to use.

    Context variables required for this template:
    * stations - list of stations (zones) with their items and question slots; roomlabel is
      plain text, empty with a single room; status is locked, available or completed (a visited
      station whose questions are not all answered is still available)
    * hasothers - whether items outside any station exist
    * others - those items
    * canswitch - show the button that switches to the 3D room

    Item fields: id, sceneid, title (plain text), html (server-formatted), text (plain text),
    imageurl, ismodel, isaudio, isvideo, mediaurl, portaltext (plain text), uselabel (plain text,
    empty when the item has no use button), hidden, slot; others also roomlabel.

    Example context (json):
    {
        "canswitch": true,
        "stations": [
            {
                "zoneid": "z-1",
                "sceneid": "s-1",
                "name": "The Vase",
                "roomlabel": "Room: Hall",
                "status": "available",
                "statuslabel": "To do",
                "badgeclass": "text-bg-info",
                "hidden": false,
                "items": [
                    {"id": "h-1", "sceneid": "s-1", "title": "The Vase", "html": "<p>Made in 1720.</p>", "text": "", "imageurl": "",
                     "ismodel": false, "isaudio": false, "isvideo": false, "mediaurl": "", "portaltext": "", "uselabel": "", "hidden": false},
                    {"id": "g-1", "sceneid": "s-1", "title": "Brass key", "html": "", "text": "", "imageurl": "",
                     "ismodel": false, "isaudio": false, "isvideo": false, "mediaurl": "", "portaltext": "", "uselabel": "Take Brass key", "hidden": false},
                    {"id": "a-1", "sceneid": "s-1", "title": "Tape", "html": "", "text": "", "imageurl": "",
                     "ismodel": false, "isaudio": true, "isvideo": false, "mediaurl": "https://example.com/tape.mp3", "portaltext": "", "uselabel": "", "hidden": false}
                ],
                "slots": [{"slot": 1}]
            }
        ],
        "hasothers": true,
        "others": [
            {"id": "t-3", "sceneid": "s-1", "title": "Notice", "html": "", "text": "Welcome", "imageurl": "", "ismodel": false,
             "isaudio": false, "isvideo": false, "mediaurl": "", "portaltext": "", "uselabel": "", "roomlabel": "", "hidden": false},
            {"id": "pt-1", "sceneid": "s-1", "title": "Cellar door", "html": "", "text": "", "imageurl": "", "ismodel": false,
             "isaudio": false, "isvideo": false, "mediaurl": "", "portaltext": "Leads to Cellar", "uselabel": "", "roomlabel": "", "hidden": false}
        ]
    }
}}
<div class="vrroom-listview" data-region="vrroom-listview">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
        <h2 class="h4 mb-0">{{#str}}listviewheading, vrroomruntime_builtin{{/str}}</h2>
        {{#canswitch}}<button type="button" class="btn btn-outline-secondary btn-sm" data-action="vrroom-switch-3d">{{#str}}switchto3d, vrroomruntime_builtin{{/str}}</button>{{/canswitch}}
    </div>
    <ol class="list-unstyled">
        {{#stations}}
        <li{{#hidden}} hidden{{/hidden}} data-region="vrroom-station-item" data-zone="{{zoneid}}">
            <section class="vrroom-station card mb-3" data-region="vrroom-station" data-zone="{{zoneid}}" data-scene="{{sceneid}}" aria-labelledby="vrroom-station-{{zoneid}}">
                <div class="card-body">
                    <div class="d-flex flex-wrap align-items-center gap-2">
                        <h3 class="h5 mb-0" id="vrroom-station-{{zoneid}}">{{name}}</h3>
                        <span class="badge {{badgeclass}}" data-region="vrroom-station-status" data-status="{{status}}">{{statuslabel}}</span>
                        {{#roomlabel}}<span class="badge bg-light text-dark" data-region="vrroom-station-room">{{roomlabel}}</span>{{/roomlabel}}
                    </div>
                    <button type="button" class="btn btn-secondary btn-sm mt-2" data-action="vrroom-open-station" data-zone="{{zoneid}}" aria-expanded="false" aria-controls="vrroom-station-body-{{zoneid}}">{{#str}}openstation, vrroomruntime_builtin{{/str}}</button>
                    <p class="text-muted mt-2 mb-0" data-region="vrroom-station-locked" hidden>{{#str}}stationlocked, vrroomruntime_builtin{{/str}}</p>
                    <div class="vrroom-station-body mt-2" id="vrroom-station-body-{{zoneid}}" data-region="vrroom-station-body" hidden>
                        {{#items}}
                        <div class="mb-2" data-interactable="{{id}}" data-scene="{{sceneid}}"{{#hidden}} hidden{{/hidden}}>
                            <h4 class="h6">{{title}}</h4>
                            {{{html}}}
                            {{#text}}<p>{{text}}</p>{{/text}}
                            {{#imageurl}}<img class="img-fluid" src="{{imageurl}}" alt="{{title}}">{{/imageurl}}
                            {{#ismodel}}<p class="text-muted">{{#str}}modelinlist, vrroomruntime_builtin{{/str}}</p>{{/ismodel}}
                            {{#isaudio}}<audio controls preload="none" src="{{mediaurl}}" aria-label="{{title}}" data-region="vrroom-media" data-item="{{id}}" data-scene="{{sceneid}}"></audio>{{/isaudio}}
                            {{#isvideo}}<video controls preload="none" class="w-100" src="{{mediaurl}}" aria-label="{{title}}" data-region="vrroom-media" data-item="{{id}}" data-scene="{{sceneid}}"></video>{{/isvideo}}
                            {{#portaltext}}<p>{{portaltext}}</p>{{/portaltext}}
                            {{#uselabel}}<button type="button" class="btn btn-outline-primary btn-sm" data-action="vrroom-use-item" data-item="{{id}}" data-scene="{{sceneid}}">{{uselabel}}</button>{{/uselabel}}
                        </div>
                        {{/items}}
                        {{#slots}}<div data-region="vrroom-question" data-slot="{{slot}}"></div>{{/slots}}
                    </div>
                </div>
            </section>
        </li>
        {{/stations}}
    </ol>
    {{#hasothers}}
    <h3 class="h5">{{#str}}otheritems, vrroomruntime_builtin{{/str}}</h3>
    <ul class="list-unstyled">
        {{#others}}
        <li class="vrroom-otheritem card mb-3" data-interactable="{{id}}" data-scene="{{sceneid}}"{{#hidden}} hidden{{/hidden}}>
            <div class="card-body">
                <div class="d-flex flex-wrap align-items-center gap-2">
                    <h4 class="h6 mb-0" id="vrroom-item-{{id}}">{{title}}</h4>
                    {{#roomlabel}}<span class="badge bg-light text-dark" data-region="vrroom-station-room">{{roomlabel}}</span>{{/roomlabel}}
                </div>
                <div class="d-flex flex-wrap gap-2 mt-2">
                    <button type="button" class="btn btn-secondary btn-sm" data-action="vrroom-open-item" data-item="{{id}}" aria-expanded="false" aria-controls="vrroom-item-body-{{id}}" aria-describedby="vrroom-item-{{id}}">{{#str}}openstation, vrroomruntime_builtin{{/str}}</button>
                    {{#uselabel}}<button type="button" class="btn btn-outline-primary btn-sm" data-action="vrroom-use-item" data-item="{{id}}" data-scene="{{sceneid}}">{{uselabel}}</button>{{/uselabel}}
                </div>
                {{#portaltext}}<p class="mt-2 mb-0">{{portaltext}}</p>{{/portaltext}}
                <div class="mt-2" id="vrroom-item-body-{{id}}" data-region="vrroom-item-body" hidden>
                    {{{html}}}
                    {{#text}}<p>{{text}}</p>{{/text}}
                    {{#imageurl}}<img class="img-fluid" src="{{imageurl}}" alt="{{title}}">{{/imageurl}}
                    {{#ismodel}}<p class="text-muted">{{#str}}modelinlist, vrroomruntime_builtin{{/str}}</p>{{/ismodel}}
                    {{#isaudio}}<audio controls preload="none" src="{{mediaurl}}" aria-label="{{title}}" data-region="vrroom-media" data-item="{{id}}" data-scene="{{sceneid}}"></audio>{{/isaudio}}
                    {{#isvideo}}<video controls preload="none" class="w-100" src="{{mediaurl}}" aria-label="{{title}}" data-region="vrroom-media" data-item="{{id}}" data-scene="{{sceneid}}"></video>{{/isvideo}}
                    {{#slot}}<div data-region="vrroom-question" data-slot="{{slot}}"></div>{{/slot}}
                </div>
            </div>
        </li>
        {{/others}}
    </ul>
    {{/hasothers}}
    <div data-region="vrroom-list-progress"></div>
</div>
