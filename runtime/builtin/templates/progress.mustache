{{!
    @template vrroomruntime_builtin/progress

    Objectives with their hints, points, the time left and the finish button. The time left is
    filled in by JavaScript every second (the paragraph stays hidden without a time limit).

    Context variables required for this template:
    * scoretext - plain-text points line
    * objectives - list of {id, status, badgeclass, statuslabel, title, hashints, canhint,
      hintsusedtext, hintcosttext, hints}; hints is a list of {text} (plain text)
    * canfinish - show the finish button (not in preview)
    * preview - show the preview notice

    Example context (json):
    {
        "scoretext": "Points: 1 of 4",
        "objectives": [
            {"id": "v-1", "status": "completed", "badgeclass": "bg-success", "statuslabel": "Done", "title": "Visit The Vase",
             "hashints": false, "canhint": false, "hintsusedtext": "", "hintcosttext": "", "hints": []},
            {"id": "q-1", "status": "available", "badgeclass": "text-bg-info", "statuslabel": "To do", "title": "Answer the question at The Vase",
             "hashints": true, "canhint": true, "hintsusedtext": "Hints used: 1 of 2", "hintcosttext": "Each hint takes 0.5 points off.",
             "hints": [{"text": "Look at the base."}]}
        ],
        "canfinish": true,
        "preview": false
    }
}}
<h2 class="h6">{{#str}}progress, vrroomruntime_builtin{{/str}}</h2>
<p class="fw-bold" data-region="vrroom-timer" hidden></p>
<p data-region="vrroom-score">{{scoretext}}</p>
<ul class="list-unstyled" data-region="vrroom-objectives">
    {{#objectives}}
    <li data-objective="{{id}}" data-status="{{status}}">
        <span class="badge {{badgeclass}} me-2">{{statuslabel}}</span><span id="vrroom-objective-title-{{id}}">{{title}}</span>
        {{#hashints}}
        <div class="vrroom-objective-hints ms-2 mb-2">
            {{#canhint}}<button type="button" class="btn btn-link btn-sm px-0" data-action="vrroom-get-hint" data-objective="{{id}}" aria-describedby="vrroom-objective-title-{{id}}">{{#str}}gethint, vrroomruntime_builtin{{/str}}</button>{{/canhint}}
            <p class="small text-muted mb-1">{{hintsusedtext}}{{#hintcosttext}} {{hintcosttext}}{{/hintcosttext}}</p>
            <ul class="vrroom-hints" data-region="vrroom-hints" data-objective="{{id}}">
                {{#hints}}<li>{{text}}</li>{{/hints}}
            </ul>
        </div>
        {{/hashints}}
    </li>
    {{/objectives}}
</ul>
{{#preview}}<p class="text-muted small">{{#str}}previewnotice, vrroomruntime_builtin{{/str}}</p>{{/preview}}
{{#canfinish}}<button type="button" class="btn btn-primary" data-action="vrroom-finish-attempt">{{#str}}finishattempt, vrroomruntime_builtin{{/str}}</button>{{/canfinish}}
