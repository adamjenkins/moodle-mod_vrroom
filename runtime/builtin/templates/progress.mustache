{{!
    @template mavrruntime_builtin/progress

    Objectives, points and the finish button.

    Context variables required for this template:
    * scoretext - plain-text points line
    * objectives - list of {id, status, badgeclass, statuslabel, title}
    * canfinish - show the finish button (not in preview)
    * preview - show the preview notice

    Example context (json):
    {
        "scoretext": "Points: 1 of 4",
        "objectives": [
            {"id": "v-1", "status": "completed", "badgeclass": "bg-success", "statuslabel": "Done", "title": "Visit The Vase"},
            {"id": "q-1", "status": "available", "badgeclass": "bg-info text-dark", "statuslabel": "To do", "title": "Answer the question at The Vase"}
        ],
        "canfinish": true,
        "preview": false
    }
}}
<h2 class="h6">{{#str}}progress, mavrruntime_builtin{{/str}}</h2>
<p data-region="mavr-score">{{scoretext}}</p>
<ul class="list-unstyled" data-region="mavr-objectives">
    {{#objectives}}<li data-objective="{{id}}" data-status="{{status}}"><span class="badge {{badgeclass}} me-2">{{statuslabel}}</span>{{title}}</li>{{/objectives}}
</ul>
{{#preview}}<p class="text-muted small">{{#str}}previewnotice, mavrruntime_builtin{{/str}}</p>{{/preview}}
{{#canfinish}}<button type="button" class="btn btn-primary" data-action="mavr-finish-attempt">{{#str}}finishattempt, mavrruntime_builtin{{/str}}</button>{{/canfinish}}
