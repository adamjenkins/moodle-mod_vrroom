{{!
    @template vrroomruntime_builtin/panel

    The overlay panel that opens for a hotspot in the 3D room.

    Context variables required for this template:
    * uid - unique id for the heading
    * id - interactable id
    * title - plain-text title (escaped here)
    * html - content already formatted by the server (format_text)
    * images - list of {url, alt}
    * hasquestion - whether a question region is added
    * slot - question slot

    Example context (json):
    {
        "uid": "a1b2",
        "id": "h-1",
        "title": "The Vase",
        "html": "<p>Made in 1720.</p>",
        "images": [{"url": "https://example.com/pluginfile.php/1/mod_vrroom/media/1/vase.jpg", "alt": "The Vase"}],
        "hasquestion": true,
        "slot": 1
    }
}}
<section class="vrroom-panel card shadow" role="dialog" aria-modal="false" aria-labelledby="vrroom-panel-title-{{uid}}" data-region="vrroom-panel" data-interactable="{{id}}">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-start">
            <h3 class="h5" id="vrroom-panel-title-{{uid}}" tabindex="-1">{{title}}</h3>
            <button type="button" class="btn-close" data-action="vrroom-close-panel" aria-label="{{#str}}closebuttontitle{{/str}}"></button>
        </div>
        <div data-region="vrroom-panel-content">{{{html}}}</div>
        <div data-region="vrroom-panel-media">{{#images}}<img class="img-fluid" src="{{url}}" alt="{{alt}}">{{/images}}</div>
        {{#hasquestion}}<div data-region="vrroom-question" data-slot="{{slot}}"></div>{{/hasquestion}}
    </div>
</section>
