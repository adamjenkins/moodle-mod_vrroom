<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="mod/vrroom/runtime/builtin/db" VERSION="2026100801" COMMENT="XMLDB file for the VR room built-in run mode (live rooms)"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../../../../../lib/xmldb/xmldb.xsd"
>
  <TABLES>
    <TABLE NAME="vrroomruntime_builtin_peers" COMMENT="People in a live room right now. Rows go when a person leaves or stops polling for 20 seconds.">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="vrroomid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="The activity."/>
        <FIELD NAME="groupid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="The group whose room it is; 0 without groups."/>
        <FIELD NAME="room" TYPE="int" LENGTH="4" NOTNULL="true" DEFAULT="1" SEQUENCE="false" COMMENT="Number of the live room within the activity (or the group), 1 upwards."/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="The person."/>
        <FIELD NAME="peerid" TYPE="char" LENGTH="32" NOTNULL="true" SEQUENCE="false" COMMENT="Random id of this presence, shown to the others in the room."/>
        <FIELD NAME="kind" TYPE="char" LENGTH="10" NOTNULL="true" DEFAULT="attempt" SEQUENCE="false" COMMENT="attempt (a learner with an attempt in progress) or preview (a teacher)."/>
        <FIELD NAME="attemptid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="The attempt in progress; 0 for a preview."/>
        <FIELD NAME="timejoined" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timeseen" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Last poll."/>
        <FIELD NAME="lastsignal" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Last time this peer sent or received a signal."/>
        <FIELD NAME="ratewindow" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Start of the current rate-limit window."/>
        <FIELD NAME="pollcount" TYPE="int" LENGTH="6" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Polls in the current window."/>
        <FIELD NAME="signalcount" TYPE="int" LENGTH="6" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Signals sent in the current window."/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="vrroomid" TYPE="foreign" FIELDS="vrroomid" REFTABLE="vrroom" REFFIELDS="id"/>
        <KEY NAME="userid" TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="peerid" UNIQUE="true" FIELDS="peerid"/>
        <INDEX NAME="vrroomid-userid" UNIQUE="true" FIELDS="vrroomid, userid"/>
        <INDEX NAME="vrroomid-groupid-room" UNIQUE="false" FIELDS="vrroomid, groupid, room"/>
        <INDEX NAME="timeseen" UNIQUE="false" FIELDS="timeseen"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="vrroomruntime_builtin_signals" COMMENT="Connection messages between the browsers of a live room, deleted when delivered or after 60 seconds.">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="vrroomid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="The activity."/>
        <FIELD NAME="frompeer" TYPE="char" LENGTH="32" NOTNULL="true" SEQUENCE="false" COMMENT="Sender peer id."/>
        <FIELD NAME="topeer" TYPE="char" LENGTH="32" NOTNULL="true" SEQUENCE="false" COMMENT="Recipient peer id."/>
        <FIELD NAME="type" TYPE="char" LENGTH="16" NOTNULL="true" SEQUENCE="false" COMMENT="description or candidates."/>
        <FIELD NAME="payload" TYPE="text" NOTNULL="true" SEQUENCE="false" COMMENT="Canonical JSON rebuilt by the server; contains network addresses."/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="vrroomid" TYPE="foreign" FIELDS="vrroomid" REFTABLE="vrroom" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="topeer" UNIQUE="false" FIELDS="topeer"/>
        <INDEX NAME="frompeer" UNIQUE="false" FIELDS="frompeer"/>
        <INDEX NAME="timecreated" UNIQUE="false" FIELDS="timecreated"/>
      </INDEXES>
    </TABLE>
  </TABLES>
</XMLDB>
